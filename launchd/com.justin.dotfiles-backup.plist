<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.justin.dotfiles-backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/justin.flammia/dotfiles/backup.sh</string>
  </array>

  <!-- Run daily at 3:00 PM -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>15</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/justin.flammia/.claude/backups/dotfiles-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/justin.flammia/.claude/backups/dotfiles-backup.log</string>

  <!-- Run on next login if the machine was off at trigger time -->
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
