.DS_Store

# ── Secrets ───────────────────────────────────────────────────────────────────
.claude/.credentials.json
.claude/.credentials.json.bak

# ── Session history (large, machine-specific) ─────────────────────────────────
.claude/history.jsonl
.claude/projects/**/*.jsonl
.claude/projects/**/subagents/
.claude/projects/**/tool-results/

# ── Ephemeral runtime dirs ────────────────────────────────────────────────────
.claude/backups/
.claude/cache/
.claude/debug/
.claude/downloads/
.claude/file-history/
.claude/ide/
.claude/image-cache/
.claude/paste-cache/
.claude/session-env/
.claude/sessions/
.claude/shell-snapshots/
.claude/skill-workspaces/
.claude/statsig/
.claude/tasks/
.claude/telemetry/
.claude/todos/
.claude/usage-data/

# ── Plans (session-scoped) ────────────────────────────────────────────────────
.claude/plans/

# ── Plugin-managed content (reinstallable via superpowers) ────────────────────
.claude/plugins/
.claude/skills/find-skills
.claude/skills/first-principles-decomposer
.claude/skills/humanizer
.claude/skills/slackfmt
.claude/skills/*-workspace/

# ── Generated/temporary files ─────────────────────────────────────────────────
.claude/security_warnings_state_*.json
.claude/stats-cache.json
.claude/.ccstatusline-version-cache
.claude/settings.json.bak
.claude/settings.json.orig
**/__pycache__/
*.pyc
*.bak
*.orig
