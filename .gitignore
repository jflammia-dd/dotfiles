.DS_Store

# ── Secrets ───────────────────────────────────────────────────────────────────
.claude/.credentials.json
.claude/.credentials.json.bak

# ── Session history (large, machine-specific) ─────────────────────────────────
.claude/history.jsonl
.claude/projects/**/*.jsonl
.claude/projects/**/subagents/
.claude/projects/**/tool-results/

# ── Ephemeral runtime dirs ────────────────────────────────────────────────────
.claude/backups/
.claude/cache/
.claude/debug/
.claude/downloads/
.claude/file-history/
.claude/ide/
.claude/image-cache/
.claude/paste-cache/
.claude/session-env/
.claude/sessions/
.claude/shell-snapshots/
.claude/skill-workspaces/
.claude/statsig/
.claude/tasks/
.claude/telemetry/
.claude/todos/
.claude/usage-data/

# ── Plans (session-scoped) ────────────────────────────────────────────────────
.claude/plans/

# ── Plugin-managed content (reinstallable via superpowers) ────────────────────
.claude/plugins/
.claude/skills/find-skills
.claude/skills/first-principles-decomposer
.claude/skills/humanizer
.claude/skills/slackfmt
.claude/skills/*-workspace/

# ── Owned cross-harness skills: credentials and generated content ─────────────
.agents/skills/**/.env
.agents/skills/**/.env.*
.agents/skills/**/.credentials.json
.agents/skills/**/credentials.json
.agents/skills/**/*.token
.agents/skills/**/*.pem
.agents/skills/**/*.key
.agents/skills/**/.git/
.agents/skills/**/cache/
.agents/skills/**/node_modules/
.agents/skills/**/.venv/

# ── gitsign: private key and generated files (public key files are tracked) ───
.config/gitsign/signing-key
.config/gitsign/signing-key.pub
.config/gitsign/.install_id

# ── Generated/temporary files ─────────────────────────────────────────────────
.claude/security_warnings_state_*.json
.claude/stats-cache.json
.claude/.ccstatusline-version-cache
.claude/settings.json.bak
.claude/settings.json.orig
**/__pycache__/
*.pyc
*.bak
*.orig
