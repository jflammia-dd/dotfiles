          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/justin.flammia/.claude/hooks/ccstatusline-cached.sh --hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
