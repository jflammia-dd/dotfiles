      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(base64:*)",
      "Bash(~/.claude/plugins/marketplaces/datadog-claude-plugins/confluence-api/scripts/**:*)",
      "Bash(git status*:*)",
      "Bash(git log*:*)",
      "Bash(git diff*:*)",
      "Bash(git fetch*:*)",
      "mcp__datadog-atlassian__update_page"
    ],
    "deny": [
      "Bash(git push --force*:*)",
      "Bash(git push *--force*:*)",
      "Bash(dd-git push --force*:*)",
      "Bash(dd-git push *--force*:*)",
      "Bash(git commit*--no-verify*:*)",
      "Bash(dd-git commit*--no-verify*:*)"
    ],
