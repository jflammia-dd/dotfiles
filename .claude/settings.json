            "command": "/Users/justin.flammia/.claude/hooks/session-end-remind.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/justin.flammia/.claude/hooks/session-start-check.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/justin.flammia/.claude/hooks/work-os-check.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/justin.flammia/.claude/hooks/ccstatusline-cached.sh --hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/justin.flammia/.claude/hooks/justins-voice-detect.sh",
            "statusMessage": "Checking writing context..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/justin.flammia/.claude/hooks/work-os-prompt-check.sh"
          }
        ]
      }
    ]
