      "Bash(gh pr list*:*)",
      "Bash(gh pr status*:*)",
      "Bash(gh pr diff*:*)",
      "Bash(gh pr checks*:*)",
      "Bash(gh issue view*:*)",
      "Bash(gh issue list*:*)",
      "Bash(gh run view*:*)",
